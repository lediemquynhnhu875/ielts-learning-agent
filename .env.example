# Copy to .env and fill in credentials. Existing shell variables take precedence.
# LLM provider: openai or deepseek.
PROVIDER=openai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Empty model uses the provider default defined in core/config.py.
GENERATOR_MODEL=

# Independent solver: a separate stateless call, even when using the same provider/model.
# Leave these unset to use the provider defaults. Cross-provider use requires both keys.
SOLVER_PROVIDER=
SOLVER_MODEL=
LLM_TIMEOUT_SECONDS=120
# Token budget per call; empty keeps the defaults (8192 / 6144).
# Reasoning models such as DeepSeek need more, e.g. 32768 and 16384.
GENERATOR_MAX_TOKENS=
SOLVER_MAX_TOKENS=

# PostgreSQL development instance started by Docker Compose.
DATABASE_URL=postgresql://ielts:ielts_dev_password@localhost:55432/ielts
# Apply pending SQL migrations before the API serves requests.
# Set false only when running the migration CLI separately.
DATABASE_AUTO_MIGRATE=true
# Optional Compose overrides; update DATABASE_URL (and TEST_DATABASE_URL) to match.
POSTGRES_PASSWORD=ielts_dev_password
POSTGRES_PORT=55432
# Optional separate database for integration tests.
# TEST_DATABASE_URL=postgresql://ielts:ielts_dev_password@localhost:55432/ielts_test
TEST_DATABASE_URL=
# Optional shared bearer token for all exercise and trace routes.
# Set this before exposing the service beyond localhost.
# Required for Listening audio authoring/previews and publication. Keep this
# server-side; only verified stored audio is available without authoring enabled.
API_TOKEN=

# --- UC-04 Speaking (agent thi thử Speaking) ---
# Groq dùng cho cả speech-to-text lẫn chấm điểm.
GROQ_API_KEY=
# STT mặc định whisper-large-v3; chỉ đổi sau khi kiểm tra audio thật.
SPEAKING_STT_MODEL=
# Chấm điểm: model chat mà tài khoản Groq gọi được.
# Đo trên hạn mức miễn phí (8.000 token/phút và 200.000 token/ngày mỗi model):
#   qwen/qwen3.8-27b    ~5.900 token mỗi lượt, hợp lệ schema
#   openai/gpt-oss-120b ~7.900 token mỗi lượt, hợp lệ schema
#   openai/gpt-oss-20b  trượt schema chấm điểm, không dùng làm grader
SPEAKING_GRADER_MODEL=qwen/qwen3.8-27b
# Model thứ hai cho giám khảo B. Mỗi model có hạn mức riêng nên cặp chấm
# không phải chờ nhau; để trống thì hai giám khảo dùng chung một hạn mức.
SPEAKING_GRADER_MODEL_B=openai/gpt-oss-120b
# Corpus band descriptors của nhóm; để trống thì dùng bản ingest sẵn.
SPEAKING_DESCRIPTORS_PATH=
# Hạ xuống nếu tài khoản có hạn mức token mỗi phút thấp hơn.
SPEAKING_GRADER_MAX_COMPLETION_TOKENS=
# low | medium | high, chỉ cần với model có reasoning.
SPEAKING_GRADER_REASONING_EFFORT=
# Viết thân câu hỏi Part 3 và kiểm tra trùng nghĩa; để trống thì về template.
SPEAKING_QUESTION_MODEL=openai/gpt-oss-20b
# Checkpoint phiên thi; mặc định data/sessions.sqlite3 trong package.
SPEAKING_DB_PATH=
# Phân tích phát âm. Audio chỉ gửi đi khi người học chọn trong giao diện.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Listening TTS: stable rotation by speaker_id; override per request if needed.
LISTENING_VOICES=en-GB-SoniaNeural,en-GB-RyanNeural
