# Copy to .env. The app loads this file automatically; shell variables take precedence.
# One shared OpenRouter key for all roles:
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# BASE_URL must include the provider's API prefix, for example .../v1.
WRITING_A_BASE_URL=
WRITING_A_MODEL=
WRITING_A_API_KEY=
WRITING_B_BASE_URL=
WRITING_B_MODEL=
WRITING_B_API_KEY=
WRITING_MODERATOR_BASE_URL=
WRITING_MODERATOR_MODEL=
WRITING_MODERATOR_API_KEY=
