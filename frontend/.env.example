# Địa chỉ backend UC-04 (chỉ đọc phía server). Mặc định http://127.0.0.1:8000.
BACKEND_URL=http://127.0.0.1:8000
# Trùng với API_TOKEN của backend nếu backend bật; để trống nếu không bật.
# Chỉ gửi tới backend UC-04, không gửi sang Speaking hay Writing.
API_TOKEN=
# Địa chỉ agent Speaking (uvicorn ielts_agent.agents.speaking.server:app --port 8010). Mặc định http://127.0.0.1:8010.
SPEAKING_BACKEND_URL=http://127.0.0.1:8010
# Địa chỉ prototype Writing (python app.py trong prototypes/writing). Mặc định http://127.0.0.1:8765.
WRITING_BACKEND_URL=http://127.0.0.1:8765
# Chế độ chấm Writing do server quyết định: live (mặc định, chấm thật) hoặc demo (điểm mô phỏng, chỉ để dev).
WRITING_MODE=live
